{
  "github": {
    "silent": true
  },
  "outputDirectory": "build/web",
  "rewrites": [
    { "source": "/api/t/chat", "destination": "/api/t/chat" },
    { "source": "/api/oracle/agent-per-ada", "destination": "/api/oracle/agent-per-ada" },
    { "source": "/api/blockfrost/:path*", "destination": "/api/blockfrost/:path*" },
    { "source": "/api/blockfrost-proxy", "destination": "/api/blockfrost-proxy" },
    { "source": "/api/handle/:path*", "destination": "/api/handle/:path*" },
    { "source": "/api/stripe/checkout", "destination": "/api/stripe/checkout" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/flutter_service_worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
} 